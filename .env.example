# ─── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
# Set DEMO_MODE=true to run fully offline (sample data, OTP code 000000,
# cookie-based session) without any Supabase/OpenAI keys.
DEMO_MODE=false

# ─── Supabase (auth + database) ───────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── LLM / OpenAI (OCR + caption generation) ──────────────────────────
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

# ─── Cloudinary (logo + asset storage) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# ─── Razorpay (subscriptions — Phase 4) ───────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
RAZORPAY_STARTER_PLAN_ID=plan_xxxxxxxx
RAZORPAY_PRO_PLAN_ID=plan_yyyyyyyy

# ─── WhatsApp OTP provider (MSG91) — Phase 1 ──────────────────────────
MSG91_AUTH_KEY=your-msg91-key
MSG91_TEMPLATE_ID=your-template-id
MSG91_SENDER_ID=MENUDR

# ─── Analytics (optional) ─────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Optional: free stock photos for the "Food image" background (pexels.com/api).
# Leave blank to use a generated gradient instead.
PEXELS_API_KEY=

# Stock photos for the "Food image" background. Unsplash is higher quality;
# Pexels is the fallback. STOCK_PROVIDER = unsplash | pexels | auto (default).
UNSPLASH_ACCESS_KEY=
STOCK_PROVIDER=auto

# Reverse geocoding for the "Use my location" feature (coords -> place name).
# Optional: without it, free OpenStreetMap Nominatim is used. Google is more
# accurate (10,000 free requests/month).
GOOGLE_GEOCODING_API_KEY=
